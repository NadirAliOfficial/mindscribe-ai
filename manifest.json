{
  "manifest_version": 3,
  "name": "ReplyMind AI",
  "version": "1.1.0",
  "description": "Smart replies and text enhancement for Fiverr, LinkedIn, WhatsApp, Telegram, Discord, Slack, and more.",

  "permissions": ["activeTab", "storage"],

  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.groq.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["portfolio.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Text Enhancer Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
